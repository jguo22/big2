{
  "name": "bigtwo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["rules", "server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @bigtwo/server",
    "dev:client": "npm run dev --workspace @bigtwo/client",
    "build": "npm run build --workspace @bigtwo/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vitest": "^3.0.5"
  }
}
